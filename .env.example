# ============================================================
# BodhSight — Environment Variable Template
# Copy to .env and fill in REAL values.
# NEVER commit .env to git.
# ============================================================

# ---- Database (Supabase) ------------------------------------
DATABASE_URL=postgresql://postgres.<your-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>    # NEVER expose to frontend

# ---- Backend ------------------------------------------------
API_V1_STR=/api/v1
APP_ENV=development                                   # development | production
DATA_SOURCE=database                                  # database | demo

# ---- AI / LLM ------------------------------------------------
# Agent 10 chat uses Gemini. Configure this in the backend/root .env only;
# never add this key to frontend/.env or frontend source code.
GEMINI_API_KEY=<your-gemini-api-key>

# Option A: OpenAI
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini                               # or gpt-4-turbo
LLM_API_KEY=<your-openai-api-key>
OPENAI_API_KEY=<your-openai-api-key>                # standard env var name

LLM_MAX_TOKENS=512
